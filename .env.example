# Meta Autom Farm - Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# Database & Redis
# ===========================================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/accfarm
REDIS_URL=redis://localhost:6379/0

# ===========================================
# Security
# ===========================================
# Generate with: openssl rand -base64 32
ACCFARM_AES_KEY=your-32-byte-base64-encoded-aes-key-here

# API key for device layer and internal services
ORCHESTRATOR_API_KEY=change-this-to-a-secure-random-string-in-production

# ===========================================
# Telegram Bot (optional but recommended)
# ===========================================
# Get token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# Your ops chat ID (get from @userinfobot or similar)
TELEGRAM_OPS_CHAT_ID=

# ===========================================
# Proxy Providers (add your chosen provider credentials)
# ===========================================
# IPRoyal example:
IPROYAL_USERNAME=
IPROYAL_PASSWORD=

# Smartproxy example:
SMARTPROXY_USERNAME=
SMARTPROXY_PASSWORD=

# ===========================================
# SMS Verification Services (for account creation)
# ===========================================
# 5sim.net API key
FIVESIM_API_KEY=

# SMS-Activate.org API key
SMS_ACTIVATE_API_KEY=

# ===========================================
# Application Settings
# ===========================================
DEBUG=true
LOG_LEVEL=INFO

# ===========================================
# Device Layer (ADB)
# ===========================================
DEVICE_LAYER_URL=http://localhost:8001

# ===========================================
# Instagram Bot Service
# ===========================================
IG_BOT_URL=http://localhost:8002

# ===========================================
# Content Storage
# ===========================================
CONTENT_STORAGE_PATH=/workspace/content
